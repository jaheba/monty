+//! Pure function speculation keeps the original frame intact until successful return.
+#![allow(unsafe_code)]
+
+use std::{ffi::c_void, ptr};
+
+use smallvec::SmallVec;
+
+use super::{RunError, VM, Value};
+use crate::{
+    builtins::{Builtins, BuiltinsFunctions},
+    bytecode::aot::{
+        self, BuiltinHint, abi,
+        backend::Artifact,
+        ir::{Element, Kind, Plan},
+    },
+    function::ExactPositionalCall,
+    types::{Range, Type, tuple::allocate_tuple},
+};
+
+struct Invocation<'vm, 'code> {
+    vm: &'vm mut VM<'code>,
+    error: Option<RunError>,
+    check_limits: bool,
+    poll_print: bool,
+    plan: &'code Plan,
+    buffers: SmallVec<[Vec<u64>; 4]>,
+}
+
+unsafe extern "C" fn checkpoint(opaque: *mut c_void, ip: usize) -> bool {
+    // SAFETY: the synchronous caller retains Invocation and its exclusive VM borrow.
+    let invocation = unsafe { &mut *opaque.cast::<Invocation<'_, '_>>() };
+    invocation.vm.instruction_ip = ip;
+    match invocation
+        .vm
+        .dispatch_checkpoint(invocation.check_limits, invocation.poll_print)
+    {
+        Ok(()) => true,
+        Err(error) => {
+            invocation.error = Some(error);
+            false
+        }
+    }
+}
+
+unsafe extern "C" fn range_init(context: *mut abi::Context, patch: *const abi::Patch) -> bool {
+    // SAFETY: called only with the current invocation and an immutable artifact patch.
+    let (context, patch) = unsafe { (&mut *context, &*patch) };
+    let count = usize::try_from(patch.immediate & 255).expect("range argument count");
+
+    if !(1..=3).contains(&count)
+        || patch.dst.checked_add(2).is_none_or(|end| end >= context.length)
+        || [patch.left, patch.right, patch.third]
+            .iter()
+            .any(|&i| i >= context.length)
+    {
+        return false;
+    }
+    // SAFETY: bounds above cover every register access and the initialized range slot.
+    unsafe {
+        let a = context.registers.add(patch.left).read().cast_signed();
+        let b = context.registers.add(patch.right).read().cast_signed();
+        let c = context.registers.add(patch.third).read().cast_signed();
+        let (start, stop, step) = match count {
+            1 => (0, a, 1),
+            2 => (a, b, 1),
+            _ => (a, b, c),
+        };
+        if step == 0 {
+            return false;
+        }
+        let remaining = Range::new(start, stop, step).len() as u64;
+        context.registers.add(patch.dst).write(start.cast_unsigned());
+        context.registers.add(patch.dst + 1).write(step.cast_unsigned());
+        context.registers.add(patch.dst + 2).write(remaining);
+    }
+    true
+}
+
+impl VM<'_> {
+    pub(super) fn try_aot(&mut self, countdown: &mut u8, check_limits: bool, poll_print: bool) -> Result<(), RunError> {
+        if self.current_frame.ip != 0
+            || self.current_frame.function_id.is_none()
+            || self.current_frame.is_parked
+            || self.current_frame.aot_attempted
+        {
+            return Ok(());
+        }
+        self.current_frame.aot_attempted = true;
+        let code = self.current_frame.code;
+        let Some(hints) = code.aot_hints() else { return Ok(()) };
+        let Some(plan) = code.aot_plan.get_or_init(|| Plan::compile(code, hints)) else {
+            return Ok(());
+        };
+        if plan.locals != usize::from(self.current_frame.locals_count) {
+            return Ok(());
+        }
+        let base = self.current_frame.stack_base();
+        if self.stack.len() != base + plan.locals {
+            return Ok(());
+        }
+        for &(slot, builtin) in &plan.builtin_globals {
+            let expected = match builtin {
+                BuiltinHint::Range => Builtins::Type(Type::Range),
+                BuiltinHint::Len => Builtins::Function(BuiltinsFunctions::Len),
+            };
+            if !matches!(self.globals.get(slot), Some(Value::Undefined))
+                && !matches!(self.globals.get(slot),Some(Value::Builtin(actual)) if *actual==expected)
+            {
+                aot::record(|s| s.fallbacks += 1);
+                return Ok(());
+            }
+        }
+        let mut arguments = SmallVec::<[u64; 8]>::new();
+        for (index, kind) in plan.parameters.iter().enumerate() {
+            let bits = match (kind, &self.stack[base + index]) {
+                (Kind::Int, Value::Int(value)) => value.cast_unsigned(),
+                (Kind::Float, Value::Float(value)) => value.to_bits(),
+                (Kind::Bool, Value::Bool(value)) => u64::from(*value),
+                (Kind::None, Value::None) | (Kind::Unknown, _) => 0,
+                (kind, value) if kind.reference() && matches_reference(*kind, value, self) => index as u64,
+                _ => {
+                    aot::record(|s| s.fallbacks += 1);
+                    return Ok(());
+                }
+            };
+            arguments.push(bits);
+        }
+        let Some(artifact) = code.aot_native.get_or_init(|| {
+            let artifact = Artifact::compile(plan, &self.heap.tracker)?;
+            aot::record(|s| {
+                s.compilations += 1;
+                s.code_bytes += artifact.code_bytes() as u64;
+            });
+            Some(artifact)
+        }) else {
+            return Ok(());
+        };
+        if self
+            .heap
+            .tracker
+            .check_allocation(artifact.registers * size_of::<u64>())
+            .is_err()
+        {
+            return Ok(());
+        }
+        let sources = if plan.needs_views { plan.parameters.len() } else { 0 };
+        if self
+            .heap
+            .tracker
+            .check_allocation(sources * (size_of::<abi::View>() + size_of::<Vec<u64>>()))
+            .is_err()
+        {
+            return Ok(());
+        }
+        let mut views = SmallVec::<[abi::View; 4]>::new();
+        views.resize(sources, abi::View::default());
+        let mut registers = SmallVec::<[u64; 64]>::new();
+        registers.resize(artifact.registers, 0);
+        for (index, bits) in arguments.into_iter().enumerate() {
+            registers[3 * index] = bits;
+            registers[3 * index + 1] = 1;
+        }
+        for &(index, bits) in &plan.initial_values {
+            registers[index] = bits;
+        }
+        let (entry, patch) = artifact.entry();
+        let mut invocation = Invocation {
+            vm: self,
+            error: None,
+            check_limits,
+            poll_print,
+            plan,
+            buffers: (0..sources).map(|_| Vec::new()).collect(),
+        };
+        let mut context = abi::Context {
+            registers: registers.as_mut_ptr(),
+            length: registers.len(),
+            remaining: usize::from(*countdown),
+            opaque: ptr::from_mut(&mut invocation).cast(),
+            checkpoint,
+            ip: 0,
+            result: 0,
+            result_kind: 0,
+            result_start: 0,
+            instructions: 0,
+            range_init,
+            views: views.as_mut_ptr(),
+            views_len: views.len(),
+            prepare_view,
+            read,
+        };
+        // SAFETY: verified typed templates access only this fixed buffer. Callback borrows end
+        // before execution continues; original arguments and code constants remain VM-owned.
+        let outcome = unsafe { entry(&raw mut context, patch) };
+        let error = invocation.error.take();
+        *countdown = u8::try_from(context.remaining).expect("AOT countdown");
+        aot::record(|s| {
+            s.entries += 1;
+            s.instructions += context.instructions;
+            if outcome == abi::RETURN {
+                s.returns += 1;
+            } else {
+                s.fallbacks += 1;
+            }
+        });
+        if let Some(error) = error {
+            return Err(error);
+        }
+        if outcome == abi::RETURN {
+            let value = match context.result_kind {
+                1 => Value::Int(context.result.cast_signed()),
+                2 => Value::Float(f64::from_bits(context.result)),
+                3 => Value::Bool(context.result != 0),
+                4 => Value::None,
+                kind if kind & 255 >= 17 && kind & 255 <= 20 => {
+                    let count = kind >> 8;
+                    let element = kind & 255;
+                    let mut values = SmallVec::new();
+                    for &bits in &registers[context.result_start..context.result_start + count] {
+                        values.push(match element {
+                            17 => Value::Int(bits.cast_signed()),
+                            18 => Value::Float(f64::from_bits(bits)),
+                            19 => Value::Bool(bits != 0),
+                            20 => Value::None,
+                            _ => unreachable!(),
+                        });
+                    }
+                    allocate_tuple(values, self.heap)
+                }
+                _ => unreachable!("verified AOT return kind"),
+            };
+            self.push(value);
+            // Reuse the VM's return handler for generators, async tasks and frame ownership.
+            self.current_frame.ip = context.ip;
+        }
+        Ok(())
+    }
+}
+
+fn original<'vm>(vm: &'vm VM<'_>, parameters: usize, index: usize) -> Option<&'vm Value> {
+    if index < parameters {
+        vm.stack.get(vm.current_frame.stack_base() + index)
+    } else {
+        vm.current_frame.code.constants().get(index - parameters)
+    }
+}
+
+fn matches_reference(kind: Kind, value: &Value, vm: &VM<'_>) -> bool {
+    use super::HeapData;
+    match (kind, value) {
+        (Kind::Str, Value::InternString(_)) => true,
+        (Kind::Str, Value::Ref(id)) => matches!(vm.heap.get(*id), HeapData::Str(_)),
+        (Kind::List(_), Value::Ref(id)) => matches!(vm.heap.get(*id), HeapData::List(_)),
+        (Kind::Tuple(_), Value::Ref(id)) => matches!(vm.heap.get(*id), HeapData::Tuple(_)),
+        (Kind::Sequence(_), Value::Ref(id)) => matches!(vm.heap.get(*id), HeapData::List(_) | HeapData::Tuple(_)),
+        (Kind::Dict(_), Value::Ref(id)) => {
+            matches!(vm.heap.get(*id),HeapData::Dict(dict) if !dict.is_counter() && !dict.is_defaultdict())
+        }
+        _ => false,
+    }
+}
+
+fn scalar(value: &Value, element: Element) -> Option<u64> {
+    match (element, value) {
+        (Element::Int, Value::Int(value)) => Some(value.cast_unsigned()),
+        (Element::Float, Value::Float(value)) => Some(value.to_bits()),
+        (Element::Bool, Value::Bool(value)) => Some(u64::from(*value)),
+        (Element::None, Value::None) => Some(0),
+        _ => None,
+    }
+}
+
+unsafe extern "C" fn prepare_view(context: *mut abi::Context, patch: *const abi::Patch) -> bool {
+    // SAFETY: both pointers are retained by the synchronous native invocation.
+    let (context, patch) = unsafe { (&mut *context, &*patch) };
+    if patch.left >= context.length {
+        return false;
+    }
+    // SAFETY: the source register is in the fixed invocation buffer.
+    let bits = unsafe { context.registers.add(patch.left).read() };
+    let Ok(index) = usize::try_from(bits) else {
+        return false;
+    };
+    if index >= context.views_len {
+        return false;
+    }
+    // SAFETY: opaque owns the VM borrow; this helper executes no Python or heap mutation.
+    let invocation = unsafe { &mut *context.opaque.cast::<Invocation<'_, '_>>() };
+    let Some(element) = invocation
+        .plan
+        .parameters
+        .get(index)
+        .and_then(|kind| kind.sequence_element())
+    else {
+        return false;
+    };
+    let vm = &*invocation.vm;
+    let Some(Value::Ref(id)) = original(vm, invocation.plan.parameters.len(), index) else {
+        return false;
+    };
+    let items = match vm.heap.get(*id) {
+        super::HeapData::List(list) => list.as_slice(),
+        super::HeapData::Tuple(tuple) => tuple.as_slice(),
+        _ => return false,
+    };
+    if items.len() > 4096 {
+        // Sparse reads should not copy an arbitrarily large input. Its original
+        // VM-owned list or tuple remains rooted while checked reads use the helper.
+        // SAFETY: index was checked against the fixed view table above.
+        unsafe {
+            context.views.add(index).write(abi::View {
+                data: ptr::null(),
+                length: items.len(),
+                prepared: 2,
+            });
+        }
+        return true;
+    }
+    let Some(bytes) = items.len().checked_mul(size_of::<u64>()) else {
+        return false;
+    };
+    if vm.heap.tracker.check_allocation(bytes).is_err() {
+        return false;
+    }
+    let mut values = Vec::with_capacity(items.len());
+    for (offset, value) in items.iter().enumerate() {
+        let Some(bits) = scalar(value, element) else {
+            return false;
+        };
+        values.push(bits);
+        if invocation.check_limits
+            && offset % 4096 == 4095
+            && let Err(error) = vm.heap.tracker.check_memory_time()
+        {
+            invocation.error = Some(error.into());
+            return false;
+        }
+    }
+    invocation.buffers[index] = values;
+    let values = &invocation.buffers[index];
+    // SAFETY: the view table is fixed and each prepared buffer is retained without resizing.
+    unsafe {
+        context.views.add(index).write(abi::View {
+            data: values.as_ptr(),
+            length: values.len(),
+            prepared: 1,
+        });
+    }
+    true
+}
+
+unsafe extern "C" fn read(context: *mut abi::Context, patch: *const abi::Patch) -> bool {
+    // SAFETY: the invocation and patch are live for this synchronous callback.
+    let (context, patch) = unsafe { (&mut *context, &*patch) };
+    if patch.left >= context.length || patch.right >= context.length || patch.dst >= context.length {
+        return false;
+    }
+    // SAFETY: both source registers were bounds-checked above.
+    let (object, key) = unsafe {
+        (
+            context.registers.add(patch.left).read(),
+            context.registers.add(patch.right).read(),
+        )
+    };
+    let Ok(object) = usize::try_from(object) else {
+        return false;
+    };
+    // SAFETY: opaque borrows the caller's live Invocation for this callback.
+    let invocation = unsafe { &*context.opaque.cast::<Invocation<'_, '_>>() };
+    let vm = &*invocation.vm;
+    let Some(Value::Ref(id)) = original(vm, invocation.plan.parameters.len(), object) else {
+        return false;
+    };
+    let data = vm.heap.get(*id);
+    let bits = if patch.immediate == 256 {
+        let length = match data {
+            super::HeapData::List(list) => list.as_slice().len(),
+            super::HeapData::Tuple(tuple) => tuple.as_slice().len(),
+            super::HeapData::Dict(dict) => dict.len(),
+            _ => return false,
+        };
+        let Ok(length) = i64::try_from(length) else {
+            return false;
+        };
+        length.cast_unsigned()
+    } else {
+        let element = match patch.immediate {
+            1 => Element::Int,
+            2 => Element::Float,
+            3 => Element::Bool,
+            4 => Element::None,
+            _ => return false,
+        };
+        if let super::HeapData::List(_) | super::HeapData::Tuple(_) = data {
+            let items = match data {
+                super::HeapData::List(list) => list.as_slice(),
+                super::HeapData::Tuple(tuple) => tuple.as_slice(),
+                _ => unreachable!(),
+            };
+            let Ok(length) = i64::try_from(items.len()) else {
+                return false;
+            };
+            let index = key.cast_signed();
+            let index = if index < 0 {
+                index.checked_add(length)
+            } else {
+                Some(index)
+            };
+            let Some(index) = index.and_then(|index| usize::try_from(index).ok()) else {
+                return false;
+            };
+            let Some(bits) = items.get(index).and_then(|value| scalar(value, element)) else {
+                return false;
+            };
+            // SAFETY: the destination register was bounds-checked at callback entry.
+            unsafe {
+                context.registers.add(patch.dst).write(bits);
+            }
+            return true;
+        }
+        let super::HeapData::Dict(dict) = data else {
+            return false;
+        };
+        let Ok(key) = usize::try_from(key) else {
+            return false;
+        };
+        let Some(key) = original(vm, invocation.plan.parameters.len(), key) else {
+            return false;
+        };
+        let key = match key {
+            Value::InternString(id) => vm.interns.get_str(*id),
+            Value::Ref(id) => match vm.heap.get(*id) {
+                super::HeapData::Str(string) => string.as_str(),
+                _ => return false,
+            },
+            _ => return false,
+        };
+        let Some(value) = dict.native_string_get(key, vm.heap, vm.interns) else {
+            return false;
+        };
+        let Some(bits) = scalar(value, element) else {
+            return false;
+        };
+        bits
+    };
+    // SAFETY: the destination is in the fixed initialized register buffer.
+    unsafe {
+        context.registers.add(patch.dst).write(bits);
+    }
+    true
+}
+
+pub(super) enum ScalarCall {
+    Unsupported,
+    Miss,
+    Value(Value),
+}
+
+unsafe extern "C" fn no_checkpoint(_: *mut c_void, _: usize) -> bool {
+    false
+}
+unsafe extern "C" fn no_helper(_: *mut abi::Context, _: *const abi::Patch) -> bool {
+    false
+}
+
+impl VM<'_> {
+    /// Finite arithmetic leaves need no physical frame or callbacks. Every guard
+    /// failure leaves the callable and arguments on the stack for ordinary binding.
+    pub(super) fn try_scalar_aot_call(
+        &mut self,
+        arguments: usize,
+        countdown: &mut u8,
+        check_limits: bool,
+        poll_print: bool,
+    ) -> Result<ScalarCall, RunError> {
+        let Some(base) = self.stack.len().checked_sub(arguments + 1) else {
+            return Ok(ScalarCall::Unsupported);
+        };
+        let Value::DefFunction(id) = self.stack[base] else {
+            return Ok(ScalarCall::Unsupported);
+        };
+        let function = self.interns.get_function(id);
+        if !matches!(function.exact_positional_call(),Some(ExactPositionalCall::Sync(count)) if count==arguments) {
+            return Ok(ScalarCall::Unsupported);
+        }
+        let code = &function.code;
+        let Some(hints) = code.aot_hints() else {
+            return Ok(ScalarCall::Unsupported);
+        };
+        let Some(plan) = code.aot_plan.get_or_init(|| Plan::compile(code, hints)) else {
+            return Ok(ScalarCall::Unsupported);
+        };
+        let Some(cost) = plan.scalar_call_cost else {
+            return Ok(ScalarCall::Unsupported);
+        };
+        if plan.parameters.len() != arguments || plan.locals != function.namespace_size {
+            return Ok(ScalarCall::Unsupported);
+        }
+        // Preserve the normal call's admission order when recursion is exhausted.
+        if self.heap.tracker.check_recursion_depth(self.recursion_depth).is_err() {
+            return Ok(ScalarCall::Unsupported);
+        }
+        let mut values = SmallVec::<[u64; 8]>::new();
+        for (kind, value) in plan.parameters.iter().zip(&self.stack[base + 1..]) {
+            let bits = match (kind, value) {
+                (Kind::Int, Value::Int(value)) => value.cast_unsigned(),
+                (Kind::Float, Value::Float(value)) => value.to_bits(),
+                (Kind::Bool, Value::Bool(value)) => u64::from(*value),
+                (Kind::None, Value::None) => 0,
+                _ => {
+                    aot::record(|s| s.fallbacks += 1);
+                    return Ok(ScalarCall::Miss);
+                }
+            };
+            values.push(bits);
+        }
+        let Some(artifact) = code.aot_native.get_or_init(|| {
+            let artifact = Artifact::compile(plan, &self.heap.tracker)?;
+            aot::record(|s| {
+                s.compilations += 1;
+                s.code_bytes += artifact.code_bytes() as u64;
+            });
+            Some(artifact)
+        }) else {
+            return Ok(ScalarCall::Unsupported);
+        };
+        if self
+            .heap
+            .tracker
+            .check_allocation(artifact.registers * size_of::<u64>())
+            .is_err()
+        {
+            return Ok(ScalarCall::Unsupported);
+        }
+        let mut recursion = self.recursion_guard()?;
+        let vm = &mut *recursion;
+        if usize::from(*countdown) < cost {
+            vm.dispatch_checkpoint(check_limits, poll_print)?;
+            *countdown = 255;
+        }
+        let mut registers = SmallVec::<[u64; 64]>::new();
+        registers.resize(artifact.registers, 0);
+        for (index, bits) in values.into_iter().enumerate() {
+            registers[3 * index] = bits;
+            registers[3 * index + 1] = 1;
+        }
+        for &(index, bits) in &plan.initial_values {
+            registers[index] = bits;
+        }
+        let mut context = abi::Context {
+            registers: registers.as_mut_ptr(),
+            length: registers.len(),
+            remaining: usize::from(*countdown),
+            opaque: ptr::null_mut(),
+            checkpoint: no_checkpoint,
+            ip: 0,
+            result: 0,
+            result_kind: 0,
+            result_start: 0,
+            instructions: 0,
+            range_init: no_helper,
+            views: ptr::null_mut(),
+            views_len: 0,
+            prepare_view: no_helper,
+            read: no_helper,
+        };
+        let (entry, patch) = artifact.entry();
+        // SAFETY: the plan has one finite scalar block, no helper operations and a
+        // complete instruction reservation. The fixed register buffer outlives the call.
+        let outcome = unsafe { entry(&raw mut context, patch) };
+        *countdown = u8::try_from(context.remaining).expect("scalar AOT countdown");
+        aot::record(|s| {
+            s.entries += 1;
+            s.instructions += context.instructions;
+        });
+        if outcome != abi::RETURN {
+            aot::record(|s| s.fallbacks += 1);
+            return Ok(ScalarCall::Miss);
+        }
+        let value = match context.result_kind {
+            1 => Value::Int(context.result.cast_signed()),
+            2 => Value::Float(f64::from_bits(context.result)),
+            3 => Value::Bool(context.result != 0),
+            4 => Value::None,
+            _ => return Ok(ScalarCall::Miss),
+        };
+        // Account for the ReturnValue handler which this path replaces.
+        *countdown = countdown.checked_sub(1).expect("reserved scalar return instruction");
+        for value in vm.stack.drain(base..) {
+            value.drop_with(vm.heap);
+        }
+        aot::record(|s| {
+            s.returns += 1;
+            s.fast_calls += 1;
+        });
+        Ok(ScalarCall::Value(value))
+    }
+}
diff --git a/crates/monty/src/bytecode/vm/native.rs b/crates/monty/src/bytecode/vm/native.rs
new file mode 100644
index 00000000..58d74799
--- /dev/null
+++ b/crates/monty/src/bytecode/vm/native.rs
@@ -0,0 +1,183 @@
+//! Synchronous native entry: the VM owns every reference throughout the invocation.
+#![allow(unsafe_code)]
+
+use std::{ffi::c_void, mem, ptr};
+
+use super::{HeapReadOutput, VM, Value};
+pub(super) use crate::bytecode::native::enabled;
+use crate::{
+    bytecode::native::{
+        self, NativeCode,
+        abi::{self, Context, Slot},
+    },
+    heap::Heap,
+};
+
+impl VM<'_> {
+    pub(super) fn try_native(&mut self, countdown: &mut u8) {
+        // Executable mappings are outside the allocator's accounting in this prototype.
+        if self.heap.tracker.max_memory().is_some() {
+            return;
+        }
+        let code = self.current_frame.code;
+        let Some(artifact) = code.native.get_or_init(|| NativeCode::compile(code)) else {
+            return;
+        };
+        let Some((entry, patch)) = artifact.entry(self.current_frame.ip) else {
+            return;
+        };
+        let base = self.current_frame.stack_base();
+        let frame_len = self.stack.len() - base;
+        if usize::from(self.current_frame.locals_count) > frame_len {
+            return;
+        }
+        if frame_len + self.globals.len() > 8192 || *countdown == 0 {
+            return;
+        }
+
+        let mut scratch = native::take_scratch();
+        scratch.stack.clear();
+        scratch.stack.extend(self.stack[base..].iter().map(native::encode));
+        scratch
+            .stack
+            .resize(frame_len + 2 * usize::from(*countdown), Slot::default());
+        scratch.globals.clear();
+        scratch.globals.extend(self.globals.iter().map(native::encode));
+        let mut context = Context {
+            stack: scratch.stack.as_mut_ptr(),
+            capacity: scratch.stack.len(),
+            sp: frame_len,
+            locals: usize::from(self.current_frame.locals_count),
+            globals: scratch.globals.as_mut_ptr(),
+            globals_len: scratch.globals.len(),
+            constants: artifact.constants.as_ptr(),
+            constants_len: artifact.constants.len(),
+            remaining: usize::from(*countdown),
+            ip: self.current_frame.ip,
+            opaque: ptr::from_mut(self).cast(),
+            lookup,
+            range_next,
+            dictionary_reads: 0,
+            range_steps: 0,
+        };
+        // SAFETY: the artifact and fixed buffers outlive this synchronous call. Stencils access
+        // only checked slots; callbacks cannot allocate or execute Python. Only range cursors mutate.
+        let last_ip = unsafe { entry(&raw mut context, patch) };
+        let executed = usize::from(*countdown) - context.remaining;
+        if executed != 0 {
+            // Decode both images before changing either source: borrowed slots may alias any
+            // original local, global or constant, including values overwritten in the native image.
+            for slot in &scratch.stack[..context.sp] {
+                scratch.stack_values.push(decode(*slot, self.heap));
+            }
+            for slot in &scratch.globals {
+                scratch.global_values.push(decode(*slot, self.heap));
+            }
+            for old in self.stack.drain(base..) {
+                old.drop_with(self.heap);
+            }
+            self.stack.append(&mut scratch.stack_values);
+            for (old, value) in self.globals.iter_mut().zip(scratch.global_values.drain(..)) {
+                mem::replace(old, value).drop_with(self.heap);
+            }
+            self.current_frame.ip = context.ip;
+            self.instruction_ip = usize::try_from(last_ip).expect("native bytecode offset");
+            *countdown = u8::try_from(context.remaining).expect("native budget only decreases");
+        }
+        native::record(|stats| {
+            stats.entries += 1;
+            stats.instructions += executed as u64;
+            stats.dictionary_reads += context.dictionary_reads;
+            stats.range_steps += context.range_steps;
+        });
+        native::put_scratch(scratch);
+    }
+}
+
+unsafe extern "C" fn range_next(opaque: *mut c_void, iterator: Slot) -> Slot {
+    let miss = Slot {
+        tag: abi::BLOCKED,
+        bits: 0,
+    };
+    if iterator.tag != abi::BORROWED {
+        return miss;
+    }
+    // SAFETY: the synchronous caller owns the unchanged VM buffers. This callback only advances
+    // an exact builtin range iterator and retains no borrow or pointer after returning.
+    let (vm, value) = unsafe {
+        (
+            &mut *opaque.cast::<VM<'_>>(),
+            &*(usize::try_from(iterator.bits).expect("native pointer width") as *const Value),
+        )
+    };
+    let Value::Ref(id) = value else { return miss };
+    let HeapReadOutput::RangeIterator(mut iterator) = vm.heap.read(*id) else {
+        return miss;
+    };
+    match iterator.get_mut(vm.heap).next_integer() {
+        Some(value) => Slot {
+            tag: abi::INT,
+            bits: value.cast_unsigned(),
+        },
+        None => Slot {
+            tag: abi::NONE,
+            bits: 0,
+        },
+    }
+}
+
+fn decode(slot: Slot, heap: &mut Heap) -> Value {
+    match slot.tag {
+        abi::UNBOUND => Value::Undefined,
+        abi::INT => Value::Int(slot.bits.cast_signed()),
+        abi::FLOAT => Value::Float(f64::from_bits(slot.bits)),
+        abi::BOOL => Value::Bool(slot.bits != 0),
+        abi::NONE => Value::None,
+        abi::BORROWED => {
+            // SAFETY: only encode creates borrowed slots, from the unchanged VM arrays or
+            // immutable constants. All sources remain alive until both images are decoded.
+            unsafe {
+                (&*(usize::try_from(slot.bits).expect("native pointer width") as *const Value)).clone_with_heap(heap)
+            }
+        }
+        _ => unreachable!("non-materializable native slot"),
+    }
+}
+
+unsafe extern "C" fn lookup(opaque: *mut c_void, object: Slot, key: Slot) -> Slot {
+    let miss = Slot {
+        tag: abi::BLOCKED,
+        bits: 0,
+    };
+    if object.tag != abi::BORROWED || key.tag != abi::BORROWED {
+        return miss;
+    }
+    // SAFETY: the native caller temporarily borrows its original VM and source Values. This
+    // callback creates no owned heap references and changes neither the VM nor its buffers.
+    let (vm, object, key) = unsafe {
+        (
+            &*opaque.cast::<VM<'_>>(),
+            &*(usize::try_from(object.bits).expect("native pointer width") as *const Value),
+            &*(usize::try_from(key.bits).expect("native pointer width") as *const Value),
+        )
+    };
+    let Value::Ref(id) = object else { return miss };
+    let HeapReadOutput::Dict(dict) = vm.heap.read(*id) else {
+        return miss;
+    };
+    let key = match key {
+        Value::InternString(id) => vm.interns.get_str(*id),
+        Value::Ref(id) => match vm.heap.get(*id) {
+            super::HeapData::Str(value) => value.as_str(),
+            _ => return miss,
+        },
+        _ => return miss,
+    };
+    let Some(value) = dict.get(vm.heap).native_string_get(key, vm.heap, vm.interns) else {
+        return miss;
+    };
+    match value {
+        Value::Int(_) | Value::Float(_) | Value::Bool(_) | Value::None => native::encode(value),
+        _ => miss,
+    }
+}
diff --git a/crates/monty/tests/native_regions.rs b/crates/monty/tests/native_regions.rs
new file mode 100644
index 00000000..03a2f3b2
--- /dev/null
+++ b/crates/monty/tests/native_regions.rs
@@ -0,0 +1,216 @@
+#![cfg(all(
+    feature = "experimental-native",
+    not(feature = "experimental-fusion"),
+    any(target_arch = "aarch64", target_arch = "x86_64")
+))]
+
+use std::time::Duration;
+
+use monty::{FunctionCall, MontyRun, RunProgress, experimental_native};
+use monty_types::{CompileOptions, MontyObject, PrintWriter, ResourceLimits, ResourceTracker};
+
+fn run(source: &str, enabled: bool) -> Result<MontyObject, String> {
+    experimental_native::set_enabled(enabled);
+    MontyRun::new(source.to_owned(), "native.py", vec![], CompileOptions::default())
+        .unwrap()
+        .run_no_limits(vec![])
+        .map_err(|error| error.to_string())
+}
+
+fn compare(source: &str) {
+    let expected = run(source, false);
+    experimental_native::reset_stats();
+    assert_eq!(run(source, true), expected, "{source}");
+    assert!(
+        experimental_native::stats().instructions > 0,
+        "no native execution: {source}"
+    );
+}
+
+#[test]
+fn varied_control_flow_and_arithmetic() {
+    for update in ["i + 3", "i * 7", "i // 3", "i % -3", "i ^ 12", "-i", "i & 7", "i | 8"] {
+        compare(&format!(
+            "def calculate(n):\n    i = -20\n    total = 0\n    while i < n:\n        if i % 2 == 0:\n            total += {update}\n        else:\n            total -= {update}\n        i += 1\n    return total\ncalculate(200)"
+        ));
+    }
+    compare(
+        "def helper(x):\n    return x * 3 + 1\ni = 0\ntotal = 0\nwhile i < 100:\n    total += helper(i)\n    i += 1\ntotal",
+    );
+    compare("total = 0\nfor i in range(100):\n    total += i * 2\ntotal");
+}
+
+#[test]
+fn guards_preserve_results_and_exception_locations() {
+    for source in [
+        "x = 9223372036854775807\nx += 1\nx * 2",
+        "x = -9223372036854775807 - 1\n-x",
+        "x = -9223372036854775807 - 1\nx // -1",
+        "x = 12\nx // 0",
+        "x = 12\nx % 0",
+        "x = 1\nx += 0.5\nx * 2",
+        "x = True\nx + 3",
+        "x = 'abc'\nx + 'def'",
+        "def f():\n    x = 1\n    return missing + x\nf()",
+        "x = 1\ntry:\n    x += 2\n    y = x // 0\nexcept ZeroDivisionError:\n    x += 10\nx",
+        "a = []\nb = a\ni = 0\nwhile i < 10:\n    a, b = b, a\n    i += 1\n(a is b, a)",
+    ] {
+        compare(source);
+    }
+}
+
+#[test]
+fn dictionary_reads_and_protocol_fallbacks() {
+    compare("row = {'price': 7}\ni = 0\ntotal = 0\nwhile i < 200:\n    total += row['price'] * 3\n    i += 1\ntotal");
+    assert!(experimental_native::stats().dictionary_reads >= 200);
+    for source in [
+        "d = {'price': 7}\nk = ''.join(['pr', 'ice'])\nx = 1\nx + d[k]",
+        "d = {'price': []}\nx = 1\nd['price']",
+        "d = {}\nx = 1\nd['missing']",
+        "from collections import defaultdict\nd = defaultdict(int)\nx = 1\nd['missing'] + x",
+        "from collections import Counter\nd = Counter()\nx = 1\nd['missing'] + x",
+        "events = []\nclass Key:\n    def __hash__(self):\n        return hash('price')\n    def __eq__(self, other):\n        events.append(other)\n        return True\nd = {Key(): 7}\nx = 1\nresult = d['price'] + x\n(result, events)",
+    ] {
+        compare(source);
+    }
+}
+
+#[test]
+fn suspension_dump_and_resume_rebuild_native_artifacts() {
+    experimental_native::set_enabled(true);
+    experimental_native::reset_stats();
+    let runner = MontyRun::new(
+        "def work():\n    x = 7\n    y = external(x * 3)\n    return y * 2 + x\nwork()".to_owned(),
+        "suspend.py",
+        vec!["external".to_owned()],
+        CompileOptions::default(),
+    )
+    .unwrap();
+    let RunProgress::FunctionCall(call) = runner
+        .start(
+            vec![MontyObject::function("external".to_owned(), None)],
+            ResourceTracker::default(),
+            PrintWriter::Disabled,
+        )
+        .unwrap()
+    else {
+        panic!("expected suspension")
+    };
+    assert_eq!(call.args.arg(0).unwrap(), MontyObject::int(21));
+    assert!(experimental_native::stats().instructions > 0);
+    let bytes = serde_json::to_vec(&call).unwrap();
+    let RunProgress::Complete(original) = call.resume(MontyObject::int(10), PrintWriter::Disabled).unwrap() else {
+        panic!("expected original completion")
+    };
+    assert_eq!(original, MontyObject::int(27));
+    experimental_native::reset_stats();
+    let restored: FunctionCall = serde_json::from_slice(&bytes).unwrap();
+    let RunProgress::Complete(result) = restored.resume(MontyObject::int(10), PrintWriter::Disabled).unwrap() else {
+        panic!("expected completion")
+    };
+    assert_eq!(result, MontyObject::int(27));
+    assert!(experimental_native::stats().compilations > 0);
+    assert!(experimental_native::stats().instructions > 0);
+}
+
+#[test]
+fn generators_can_resume_between_native_regions() {
+    compare("def values():\n    i = 0\n    while i < 30:\n        i += 1\n        yield i * 2\nlist(values())");
+}
+
+#[test]
+fn range_cursors_preserve_aliases_and_partial_progress() {
+    for source in [
+        "s = 0\nfor i in range(200):\n    s += i * 2\n(s, i)",
+        "s = 0\nfor i in range(20, -30, -3):\n    if i % 2:\n        s += i\n(s, i)",
+        "it = iter(range(10))\nvalues = []\nfor i in it:\n    values.append((i, next(it, None)))\nvalues",
+        "s = 0\nfor i in range(10):\n    s += 0.5\n(s, i)",
+        "s = 0\nfor i in range(10):\n    if i == 4:\n        break\n    s += i\n(s, i)",
+        "s = 0\nfor i in range(0):\n    s += i\ns",
+    ] {
+        compare(source);
+        assert!(experimental_native::stats().range_steps > 0);
+    }
+}
+
+#[test]
+fn advanced_range_cursor_survives_suspension_and_serialization() {
+    experimental_native::set_enabled(true);
+    experimental_native::reset_stats();
+    let runner = MontyRun::new(
+        "s = 0\nfor i in range(6):\n    s += i\n    if i == 2:\n        s += external(s)\n(s, i)".to_owned(),
+        "range_suspend.py",
+        vec!["external".to_owned()],
+        CompileOptions::default(),
+    )
+    .unwrap();
+    let RunProgress::FunctionCall(call) = runner
+        .start(
+            vec![MontyObject::function("external".to_owned(), None)],
+            ResourceTracker::default(),
+            PrintWriter::Disabled,
+        )
+        .unwrap()
+    else {
+        panic!("expected suspension")
+    };
+    assert_eq!(call.args.arg(0).unwrap(), MontyObject::int(3));
+    assert!(experimental_native::stats().range_steps >= 3);
+    let bytes = serde_json::to_vec(&call).unwrap();
+    let RunProgress::Complete(expected) = call.resume(MontyObject::int(10), PrintWriter::Disabled).unwrap() else {
+        panic!("expected original completion")
+    };
+    experimental_native::reset_stats();
+    let restored: FunctionCall = serde_json::from_slice(&bytes).unwrap();
+    let RunProgress::Complete(result) = restored.resume(MontyObject::int(10), PrintWriter::Disabled).unwrap() else {
+        panic!("expected restored completion")
+    };
+    assert_eq!(result, expected);
+    assert!(experimental_native::stats().range_steps >= 3);
+}
+
+#[test]
+fn native_loops_keep_deadline_checkpoints() {
+    experimental_native::set_enabled(true);
+    experimental_native::reset_stats();
+    let mut runner = MontyRun::new(
+        "x = 0\nwhile True:\n    x += 1".to_owned(),
+        "timeout.py",
+        vec![],
+        CompileOptions::default(),
+    )
+    .unwrap();
+    let error = runner
+        .run(
+            vec![],
+            ResourceTracker::new(ResourceLimits::default().max_turn_duration(Duration::from_millis(10))),
+            PrintWriter::Disabled,
+        )
+        .unwrap_err();
+    assert!(error.to_string().contains("time limit"), "{error}");
+    assert!(experimental_native::stats().instructions > 0);
+}
+
+#[test]
+fn configured_memory_limits_use_the_interpreter() {
+    experimental_native::set_enabled(true);
+    experimental_native::reset_stats();
+    let mut runner = MontyRun::new(
+        "x = 1\nx + 2".to_owned(),
+        "memory.py",
+        vec![],
+        CompileOptions::default(),
+    )
+    .unwrap();
+    assert_eq!(
+        runner
+            .run(
+                vec![],
+                ResourceTracker::new(ResourceLimits::default().max_memory(1024 * 1024)),
+                PrintWriter::Disabled,
+            )
+            .unwrap(),
+        MontyObject::int(3)
+    );
+    assert_eq!(experimental_native::stats().instructions, 0);
+}
diff --git a/crates/monty/tests/typed_aot.rs b/crates/monty/tests/typed_aot.rs
new file mode 100644
index 00000000..1dd58781
--- /dev/null
+++ b/crates/monty/tests/typed_aot.rs
@@ -0,0 +1,482 @@
+#![cfg(all(
+    feature = "experimental-aot",
+    not(feature = "experimental-fusion"),
+    any(target_arch = "aarch64", target_arch = "x86_64")
+))]
+
+use monty::{MontyRun, experimental_aot, experimental_native};
+use monty_types::{CompileOptions, MontyObject};
+
+fn run(source: &str, enabled: bool) -> Result<MontyObject, String> {
+    experimental_native::set_enabled(false);
+    experimental_aot::set_enabled(enabled);
+    MontyRun::new(source.to_owned(), "aot.py", vec![], CompileOptions::default())
+        .unwrap()
+        .run_no_limits(vec![])
+        .map_err(|error| error.to_string())
+}
+
+fn compare(source: &str, native_return: bool) {
+    let expected = run(source, false);
+    experimental_aot::reset_stats();
+    assert_eq!(run(source, true), expected, "{source}");
+    if native_return {
+        assert!(
+            experimental_aot::stats().returns > 0,
+            "no optimized return: {source}; {:?}",
+            experimental_aot::stats()
+        );
+    }
+}
+
+#[test]
+fn scalar_functions_and_loops() {
+    for update in ["i + 3", "i * 7", "i // 3", "i % -3", "i ^ 12", "-i", "i & 7", "i | 8"] {
+        compare(
+            &format!(
+                "def calculate(n: int) -> int:\n    i = -20\n    total = 0\n    while i < n:\n        if i % 2 == 0:\n            total += {update}\n        else:\n            total -= {update}\n        i += 1\n    return total\ncalculate(200)"
+            ),
+            true,
+        );
+    }
+    compare("def f(x: int, y: int) -> int:\n    return x + y * 3\nf(4, 9)", true);
+    compare("def f(x: int) -> int:\n    return x + (x := 2)\nf(7)", true);
+    compare(
+        "def f(x: int, y: int) -> int:\n    tmp = x\n    x = y\n    y = tmp\n    return x * 10 + y\nf(2, 3)",
+        true,
+    );
+    compare(
+        "def f(x: int) -> int:\n    while x < 100:\n        x += 1\n    return x\nf(0)",
+        true,
+    );
+}
+
+#[test]
+fn runtime_guards_and_errors() {
+    for source in [
+        "def f(x: int) -> int:\n    return x + 1\nf(9223372036854775807)",
+        "def f(x: int) -> int:\n    return -x\nf(-9223372036854775807 - 1)",
+        "def f(x: int) -> int:\n    return x // -1\nf(-9223372036854775807 - 1)",
+        "def f(x: int) -> int:\n    return x // 0\nf(12)",
+        "def f(x: int) -> int:\n    return x % 0\nf(12)",
+        "def f(x: int) -> int:\n    return x + 1\nf(0.5)",
+        "def f(x: int) -> int:\n    return x + 1\nf(True)",
+        "def f(x: int) -> int:\n    return x + 1\nf(999999999999999999999)",
+        "def f(x: int) -> int:\n    return x + 1\nf('hello')",
+        "def f(n: int) -> int:\n    if n:\n        x = 1\n    x\n    return 3\nf(0)",
+    ] {
+        compare(source, false);
+    }
+}
+
+#[test]
+fn floating_point_and_boolean_semantics() {
+    for expression in [
+        "x + y", "x - y", "x * y", "x / y", "x == y", "x != y", "x < y", "not x", "-x",
+    ] {
+        compare(
+            &format!("def f(x: float, y: float):\n    return {expression}\nf(3.25, -2.5)"),
+            true,
+        );
+    }
+    for expression in ["x + y", "x & y", "x | y", "x ^ y", "~x", "not x", "x == y"] {
+        compare(
+            &format!("def f(x: bool, y: bool):\n    return {expression}\nf(True, False)"),
+            true,
+        );
+    }
+    for expression in ["x == y", "x < y", "x + y", "x / y"] {
+        compare(
+            &format!("def f(x: int, y: float):\n    return {expression}\nf(9007199254740993, 9007199254740992.0)"),
+            false,
+        );
+    }
+    compare("def f(x: int,y: int):\n    return x / y\nf(9007199254740993,3)", false);
+    compare("def f(x: float,y: float):\n    return x / y\nf(2.0,0.0)", false);
+}
+
+#[test]
+fn short_circuit_and_unbound_locals() {
+    for source in [
+        "def f(x: int,y: int):\n    return x or y\nf(0,9)",
+        "def f(x: int,y: int):\n    return x and y\nf(5,9)",
+        "def f(x: int):\n    if x > 0:\n        y = 3\n    else:\n        y = 5\n    return y * 2\nf(-1)",
+        "def f(x: int):\n    a = 2\n    b = 3\n    while x > 0:\n        tmp = a\n        a = b\n        b = tmp\n        x -= 1\n    return a * 10 + b\nf(5)",
+    ] {
+        compare(source, true);
+    }
+    compare(
+        "def f(x: int):\n    if x:\n        y = 2\n    y\n    return 3\nf(0)",
+        false,
+    );
+}
+
+#[test]
+fn virtual_range_loops() {
+    for range in ["range(n)", "range(-10,n,3)", "range(n,-10,-3)", "range(0)"] {
+        compare(
+            &format!(
