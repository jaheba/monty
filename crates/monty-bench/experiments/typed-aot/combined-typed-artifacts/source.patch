+                            Kind::Range | Kind::Iterator | Kind::SequenceIterator(_) | Kind::Maybe(_)
+                        ) {
+                            plan.fresh_range()?
+                        } else {
+                            plan.fresh()?
+                        };
+                        output.push(Instruction {
+                            ip: last.ip,
+                            weight: 0,
+                            operation: Operation::Copy { dst: temp, src, kind },
