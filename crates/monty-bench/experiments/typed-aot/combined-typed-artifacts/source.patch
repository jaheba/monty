+++ b/crates/monty/src/bytecode/aot/abi.rs
@@ -0,0 +1,55 @@
+//! Fixed ABI for typed stencils; Rust VM and heap layouts stay behind callbacks.
+#![allow(dead_code)]
+
+use std::ffi::c_void;
+
+pub type Entry = unsafe extern "C" fn(*mut Context, *const Patch) -> u64;
+pub type Checkpoint = unsafe extern "C" fn(*mut c_void, usize) -> bool;
+pub type Helper = unsafe extern "C" fn(*mut Context, *const Patch) -> bool;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub struct View {
+    pub data: *const u64,
+    pub length: usize,
+    pub prepared: usize,
+}
+
+#[repr(C)]
+pub struct Context {
+    pub registers: *mut u64,
+    pub length: usize,
+    pub remaining: usize,
+    pub opaque: *mut c_void,
+    pub checkpoint: Checkpoint,
+    pub ip: usize,
+    pub result: u64,
+    pub result_kind: usize,
+    pub result_start: usize,
+    pub instructions: u64,
+    pub range_init: Helper,
+    pub views: *mut View,
+    pub views_len: usize,
+    pub prepare_view: Helper,
+    pub read: Helper,
+}
+
+#[repr(C)]
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Patch {
+    pub dst: usize,
+    pub left: usize,
+    pub right: usize,
+    pub third: usize,
+    pub immediate: u64,
+    pub ip: usize,
+    pub weight: usize,
+    pub next: usize,
+    pub next_data: usize,
+    pub alternate: usize,
+    pub alternate_data: usize,
+}
+
+pub const MISS: u64 = 0;
+pub const RETURN: u64 = 1;
+pub const ERROR: u64 = 2;
diff --git a/crates/monty/src/bytecode/aot/backend.rs b/crates/monty/src/bytecode/aot/backend.rs
new file mode 100644
index 00000000..7c98295e
--- /dev/null
+++ b/crates/monty/src/bytecode/aot/backend.rs
@@ -0,0 +1,493 @@
+//! Link typed operations from offline templates without a runtime compiler dependency.
+#![allow(unsafe_code)]
+
+use std::{
+    io, mem, ptr,
+    sync::atomic::{AtomicUsize, Ordering},
+};
+
+use memmap2::{Mmap, MmapMut};
+
+use super::{
+    abi::{Entry, Patch},
+    ir::{Kind, Operation, Plan, Terminator},
+};
+use crate::bytecode::Opcode;
+
+include!(concat!(env!("OUT_DIR"), "/aot_stencils.rs"));
+include!(concat!(env!("OUT_DIR"), "/aot_shared_stencils.rs"));
+static MAPPED_BYTES: AtomicUsize = AtomicUsize::new(0);
+const MAX_MAPPED_BYTES: usize = 8 * 1024 * 1024;
+
+#[derive(Debug)]
+struct MappingBudget(usize);
+impl Drop for MappingBudget {
+    fn drop(&mut self) {
+        MAPPED_BYTES.fetch_sub(self.0, Ordering::Relaxed);
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct Artifact {
+    memory: Option<Mmap>,
+    entry: Entry,
+    patches: Vec<Patch>,
+    pub registers: usize,
+    _budget: Option<MappingBudget>,
+    _external_memory: Option<monty_alloc::ExternalMemory>,
+}
+
+struct Node {
+    stencil: &'static str,
+    patch: Patch,
+    next: usize,
+    alternate: usize,
+}
+
+impl Artifact {
+    pub(crate) fn entry(&self) -> (Entry, *const Patch) {
+        (self.entry, self.patches.as_ptr())
+    }
+
+    pub(crate) fn code_bytes(&self) -> usize {
+        self.memory.as_ref().map_or(0, |memory| memory.len())
+    }
+
+    pub(crate) fn compile(plan: &Plan, tracker: &monty_types::ResourceTracker) -> Option<Self> {
+        Self::link(plan, tracker).ok()
+    }
+
+    fn link(plan: &Plan, tracker: &monty_types::ResourceTracker) -> io::Result<Self> {
+        let invalid = || io::Error::other("unsupported typed native plan");
+        let registers = plan.registers.checked_add(2).ok_or_else(invalid)?;
+        let temps = [plan.registers, plan.registers + 1];
+        // A mixed numeric operation adds at most two conversion nodes. Preflight
+        // linker scratch before constructing it, including patch and address tables.
+        let maximum_nodes = plan
+            .blocks
+            .iter()
+            .try_fold(plan.blocks.len(), |count, block| {
+                count.checked_add(block.instructions.len().checked_mul(3)?)
+            })
+            .filter(|count| *count <= 16_384)
+            .ok_or_else(invalid)?;
+        let scratch = maximum_nodes
+            .checked_mul(size_of::<Node>() + 2 * size_of::<Patch>() + 3 * size_of::<usize>())
+            .ok_or_else(invalid)?;
+        tracker.check_allocation(scratch).map_err(|_| invalid())?;
+        let mut nodes = Vec::with_capacity(maximum_nodes);
+        let mut blocks = Vec::with_capacity(plan.blocks.len());
+        let mut terminals = Vec::with_capacity(plan.blocks.len());
+        for block in &plan.blocks {
+            blocks.push(nodes.len());
+            for instruction in &block.instructions {
+                let mut patch = Patch {
+                    ip: instruction.ip,
+                    weight: instruction.weight,
+                    ..Patch::default()
+                };
+                let stencil = match instruction.operation {
+                    Operation::Copy { dst, src, kind } => {
+                        patch.dst = dst;
+                        patch.left = src;
+                        if matches!(
+                            kind,
+                            Kind::Range | Kind::Iterator | Kind::SequenceIterator(_) | Kind::Maybe(_)
+                        ) {
+                            "triple"
+                        } else {
+                            "copy"
+                        }
+                    }
+                    Operation::Range { dst, ref arguments } => {
+                        if arguments.is_empty() || arguments.len() > 3 {
+                            return Err(invalid());
+                        }
+                        patch.dst = dst;
+                        patch.left = arguments[0];
+                        patch.right = *arguments.get(1).unwrap_or(&0);
+                        patch.third = *arguments.get(2).unwrap_or(&0);
+                        patch.immediate = arguments.len() as u64;
+                        "range"
+                    }
+                    Operation::Iter { dst, src, kind } => {
+                        patch.dst = dst;
+                        patch.left = src;
+                        if kind == Kind::Range { "triple" } else { "sequence_iter" }
+                    }
+                    Operation::Checkpoint => "jump",
+                    Operation::GuardBound { src } => {
+                        patch.left = src;
+                        "bound"
+                    }
+                    Operation::Bound { dst, bound } => {
+                        patch.dst = dst;
+                        patch.immediate = u64::from(bound);
+                        "immediate"
+                    }
+                    Operation::Index { dst, object, key, kind } => {
+                        patch.dst = dst;
+                        patch.left = object;
+                        patch.right = key;
+                        if let Some(element) = kind.sequence_element() {
+                            patch.immediate = element as u64;
+                            "index"
+                        } else if let Kind::Dict(element) = kind {
+                            patch.immediate = element as u64;
+                            "read"
+                        } else {
+                            return Err(invalid());
+                        }
+                    }
+                    Operation::Length { dst, object, kind } => {
+                        if !kind.reference() {
+                            return Err(invalid());
+                        }
+                        patch.dst = dst;
+                        patch.left = object;
+                        patch.immediate = 256;
+                        "read"
+                    }
+                    Operation::Unpack {
+                        dst,
+                        object,
+                        count,
+                        element,
+                    } => {
+                        patch.dst = dst;
+                        patch.left = object;
+                        patch.immediate = ((count as u64) << 8) | element as u64;
+                        "unpack"
+                    }
+                    Operation::Unary { dst, src, op, kind } => {
+                        patch.dst = dst;
+                        patch.left = src;
+                        match op {
+                            Opcode::UnaryPos => "copy",
+                            Opcode::UnaryNeg => {
+                                if kind == Kind::Float {
+                                    "fneg"
+                                } else {
+                                    "ineg"
+                                }
+                            }
+                            Opcode::UnaryNot => {
+                                if kind == Kind::Float {
+                                    "fnot"
+                                } else {
+                                    "inot"
+                                }
+                            }
+                            Opcode::UnaryInvert => "invert",
+                            _ => return Err(invalid()),
+                        }
+                    }
+                    Operation::Binary {
+                        dst,
+                        left,
+                        right,
+                        op,
+                        lhs,
+                        rhs,
+                    } => {
+                        patch.dst = dst;
+                        patch.left = left;
+                        patch.right = right;
+                        let compare = matches!(
+                            op,
+                            Opcode::CompareEq
+                                | Opcode::CompareNe
+                                | Opcode::CompareLt
+                                | Opcode::CompareLe
+                                | Opcode::CompareGt
+                                | Opcode::CompareGe
+                        );
+                        if lhs == Kind::None || rhs == Kind::None {
+                            if !matches!(
+                                op,
+                                Opcode::CompareEq | Opcode::CompareNe | Opcode::CompareIs | Opcode::CompareIsNot
+                            ) {
+                                return Err(invalid());
+                            }
+                            patch.immediate =
+                                u64::from((lhs == rhs) == matches!(op, Opcode::CompareEq | Opcode::CompareIs));
+                            "immediate"
+                        } else {
+                            let floating = lhs == Kind::Float
+                                || rhs == Kind::Float
+                                || matches!(op, Opcode::BinaryDiv | Opcode::InplaceDiv);
+                            if floating {
+                                for (source, kind, temp, is_left) in
+                                    [(left, lhs, temps[0], true), (right, rhs, temps[1], false)]
+                                {
+                                    if kind != Kind::Float {
+                                        let conversion = Patch {
+                                            dst: temp,
+                                            left: source,
+                                            ip: instruction.ip,
+                                            weight: patch.weight,
+                                            ..Patch::default()
+                                        };
+                                        patch.weight = 0;
+                                        let exact = compare || matches!(op, Opcode::BinaryDiv | Opcode::InplaceDiv);
+                                        let next = nodes.len() + 1;
+                                        nodes.push(Node {
+                                            stencil: if exact { "exact_float" } else { "float" },
+                                            patch: conversion,
+                                            next,
+                                            alternate: next,
+                                        });
+                                        if is_left { patch.left = temp } else { patch.right = temp }
+                                    }
+                                }
+                            }
+                            match (op, floating) {
+                                (Opcode::BinaryAdd | Opcode::InplaceAdd, false) => "iadd",
+                                (Opcode::BinarySub | Opcode::InplaceSub, false) => "isub",
+                                (Opcode::BinaryMul | Opcode::InplaceMul, false) => "imul",
+                                (Opcode::BinaryFloorDiv | Opcode::InplaceFloorDiv, false) => "ifloor",
+                                (Opcode::BinaryMod | Opcode::InplaceMod, false) => "imod",
+                                (Opcode::BinaryAnd | Opcode::InplaceAnd, false) => "and",
+                                (Opcode::BinaryOr | Opcode::InplaceOr, false) => "or",
+                                (Opcode::BinaryXor | Opcode::InplaceXor, false) => "xor",
+                                (Opcode::BinaryAdd | Opcode::InplaceAdd, true) => "fadd",
+                                (Opcode::BinarySub | Opcode::InplaceSub, true) => "fsub",
+                                (Opcode::BinaryMul | Opcode::InplaceMul, true) => "fmul",
+                                (Opcode::BinaryDiv | Opcode::InplaceDiv, true) => "fdiv",
+                                (Opcode::CompareEq | Opcode::CompareIs, false) => "ieq",
+                                (Opcode::CompareNe | Opcode::CompareIsNot, false) => "ine",
+                                (Opcode::CompareLt, false) => "ilt",
+                                (Opcode::CompareLe, false) => "ile",
+                                (Opcode::CompareGt, false) => "igt",
+                                (Opcode::CompareGe, false) => "ige",
+                                (Opcode::CompareEq, true) => "feq",
+                                (Opcode::CompareNe, true) => "fne",
+                                (Opcode::CompareLt, true) => "flt",
+                                (Opcode::CompareLe, true) => "fle",
+                                (Opcode::CompareGt, true) => "fgt",
+                                (Opcode::CompareGe, true) => "fge",
+                                _ => return Err(invalid()),
+                            }
+                        }
+                    }
+                };
+                let next = nodes.len() + 1;
+                nodes.push(Node {
+                    stencil,
+                    patch,
+                    next,
+                    alternate: next,
+                });
+            }
+            let mut patch = Patch {
+                ip: block.terminal_ip,
+                weight: block.terminal_weight,
+                ..Patch::default()
+            };
+            let (stencil, next, alternate) = match block.terminator {
+                Terminator::Jump(target) => ("jump", target, target),
+                Terminator::ForIter {
+                    iterator,
+                    item,
+                    element,
+                    yes,
+                    no,
+                } => {
+                    patch.left = iterator;
+                    patch.dst = item;
+                    if let Some(element) = element {
+                        patch.right = iterator + 1;
+                        patch.immediate = element as u64;
+                        ("sequence_next", yes, no)
+                    } else {
+                        ("for_iter", yes, no)
+                    }
+                }
+                Terminator::Branch {
+                    condition,
+                    kind,
+                    yes,
+                    no,
+                } => {
+                    patch.left = condition;
+                    (if kind == Kind::Float { "fbranch" } else { "ibranch" }, yes, no)
+                }
+                Terminator::Return { source, kind } => {
+                    patch.left = source;
+                    patch.immediate = match kind {
+                        Kind::Int => 1,
+                        Kind::Float => 2,
+                        Kind::Bool => 3,
+                        Kind::None => 4,
+                        Kind::TupleValue(element, count) => (u64::from(count) << 8) | (16 + element as u64),
+                        _ => return Err(invalid()),
+                    };
+                    ("return", 0, 0)
+                }
+            };
+            terminals.push(nodes.len());
+            nodes.push(Node {
+                stencil,
+                patch,
+                next,
+                alternate,
+            });
+        }
+        for index in terminals {
+            let node = &mut nodes[index];
+            node.next = *blocks.get(node.next).ok_or_else(invalid)?;
+            node.alternate = *blocks.get(node.alternate).ok_or_else(invalid)?;
+        }
+        if nodes.is_empty() || nodes.len() > 16_384 {
+            return Err(invalid());
+        }
+        if super::backend() == super::Backend::Shared {
+            let metadata = nodes.len().checked_mul(size_of::<Patch>()).ok_or_else(invalid)?;
+            tracker.check_allocation(metadata).map_err(|_| invalid())?;
+            let mut patches = vec![Patch::default(); nodes.len()];
+            // Vec moves do not retag its allocation. Build every internal pointer
+            // from one raw base and initialize through that base before publication.
+            let patch_base = patches.as_mut_ptr();
+            let patch_address = |index| {
+                if index >= nodes.len() {
+                    return Err(invalid());
+                }
+                Ok(patch_base.wrapping_add(index) as usize)
+            };
+            let mut addresses = Vec::with_capacity(nodes.len());
+            for node in &nodes {
+                let entry = SHARED_STENCILS
+                    .iter()
+                    .find(|(name, _)| *name == node.stencil)
+                    .ok_or_else(invalid)?
+                    .1;
+                addresses.push(entry);
+            }
+            for (index, node) in nodes.iter().enumerate() {
+                if node.patch.dst >= registers
+                    || node.patch.left >= registers
+                    || node.patch.right >= registers
+                    || node.patch.third >= registers
+                    || node.patch.weight > 255
+                {
+                    return Err(invalid());
+                }
+                let next_data = patch_address(node.next)?;
+                let alternate_data = patch_address(node.alternate)?;
+                let patch = Patch {
+                    next: *addresses.get(node.next).ok_or_else(invalid)? as usize,
+                    next_data,
+                    alternate: *addresses.get(node.alternate).ok_or_else(invalid)? as usize,
+                    alternate_data,
+                    ..node.patch
+                };
+                // SAFETY: index is within this fixed initialized vector; no references
+                // into it coexist with these writes or escape before publication.
+                unsafe {
+                    patch_base.add(index).write(patch);
+                }
+            }
+            super::record(|stats| stats.shared_compilations += 1);
+            return Ok(Self {
+                memory: None,
+                entry: addresses[0],
+                patches,
+                registers,
+                _budget: None,
+                _external_memory: None,
+            });
+        }
+        let stencil = |name| {
+            STENCILS
+                .iter()
+                .find(|(candidate, _)| *candidate == name)
+                .map(|(_, bytes)| *bytes)
+                .ok_or_else(invalid)
+        };
+        let mut offsets = Vec::with_capacity(nodes.len());
+        let mut size = 0;
+        for node in &nodes {
+            if node.patch.dst >= registers
+                || node.patch.left >= registers
+                || node.patch.right >= registers
+                || node.patch.third >= registers
+                || node.patch.weight > 255
+            {
+                return Err(invalid());
+            }
+            size = (size + 15) & !15;
+            offsets.push(size);
+            size += stencil(node.stencil)?.len();
+        }
+        if size > 4 * 1024 * 1024 {
+            return Err(invalid());
+        }
+        let reservation = size.next_multiple_of(65_536);
+        let metadata = nodes.len().checked_mul(size_of::<Patch>() * 2).ok_or_else(invalid)?;
+        tracker
+            .check_allocation(reservation.checked_add(metadata).ok_or_else(invalid)?)
+            .map_err(|_| invalid())?;
+        let mut used = MAPPED_BYTES.load(Ordering::Relaxed);
+        loop {
+            let total = used
+                .checked_add(reservation)
+                .filter(|&n| n <= MAX_MAPPED_BYTES)
+                .ok_or_else(invalid)?;
+            match MAPPED_BYTES.compare_exchange_weak(used, total, Ordering::Relaxed, Ordering::Relaxed) {
+                Ok(_) => break,
+                Err(current) => used = current,
+            }
+        }
+        let budget = MappingBudget(reservation);
+        let external_memory = monty_alloc::ExternalMemory::new(reservation);
+        let mut memory = MmapMut::map_anon(size)?;
+        let base = memory.as_ptr() as usize;
+        let mut patches = vec![Patch::default(); nodes.len()];
+        let patch_base = patches.as_mut_ptr();
+        let destination = |index: usize| -> io::Result<(usize, usize)> {
+            Ok((
+                base + *offsets.get(index).ok_or_else(invalid)?,
+                patch_base.wrapping_add(index) as usize,
+            ))
+        };
+        let mut prepared = Vec::with_capacity(nodes.len());
+        for (index, node) in nodes.iter().enumerate() {
+            let bytes = stencil(node.stencil)?;
+            memory[offsets[index]..offsets[index] + bytes.len()].copy_from_slice(bytes);
+            let (next, next_data) = destination(node.next)?;
+            let (alternate, alternate_data) = destination(node.alternate)?;
+            prepared.push(Patch {
+                next,
+                next_data,
+                alternate,
+                alternate_data,
+                ..node.patch
+            });
+        }
+        // SAFETY: both buffers contain exactly nodes.len() initialized patches and
+        // do not overlap. Raw initialization preserves the graph pointers' provenance.
+        unsafe {
+            ptr::copy_nonoverlapping(prepared.as_ptr(), patch_base, prepared.len());
+        }
+        let memory = memory.make_exec()?;
+        if memory.as_ptr() as usize != base {
+            return Err(invalid());
+        }
+        // SAFETY: the initialized mapping is immutable and retained for every invocation.
+        unsafe {
+            wasmtime_internal_jit_icache_coherence::clear_cache(memory.as_ptr().cast(), memory.len())
+                .map_err(io::Error::other)?;
+        }
+        wasmtime_internal_jit_icache_coherence::pipeline_flush_mt().map_err(io::Error::other)?;
+        // SAFETY: the first checked template starts at this immutable RX mapping's base.
+        let entry = unsafe { mem::transmute::<*const u8, Entry>(memory.as_ptr()) };
+        Ok(Self {
+            memory: Some(memory),
+            entry,
+            patches,
+            registers,
+            _budget: Some(budget),
+            _external_memory: Some(external_memory),
+        })
+    }
+}
diff --git a/crates/monty/src/bytecode/aot/hints.rs b/crates/monty/src/bytecode/aot/hints.rs
new file mode 100644
index 00000000..429a7262
--- /dev/null
+++ b/crates/monty/src/bytecode/aot/hints.rs
@@ -0,0 +1,134 @@
+//! Bounded annotation hints retained separately from Python execution semantics.
+
+use ruff_python_ast::{self as ast, Expr};
+use ruff_text_size::Ranged;
+
+use crate::intern::StringId;
+
+/// An annotation can suggest a fast path; its runtime value must still be guarded.
+#[derive(Debug, Clone, Default, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub enum TypeHint {
+    #[default]
+    #[serde(rename = "U")]
+    Unknown,
+    #[serde(rename = "I")]
+    Int,
+    #[serde(rename = "F")]
+    Float,
+    #[serde(rename = "B")]
+    Bool,
+    #[serde(rename = "N")]
+    None,
+    #[serde(rename = "S")]
+    Str,
+    #[serde(rename = "L")]
+    List(Box<Self>),
+    #[serde(rename = "T")]
+    Tuple(Box<Self>),
+    #[serde(rename = "D")]
+    Dict {
+        #[serde(rename = "K")]
+        key: Box<Self>,
+        #[serde(rename = "V")]
+        value: Box<Self>,
+    },
+    #[serde(rename = "O")]
+    Union(Vec<Self>),
+}
+
+impl TypeHint {
+    pub(crate) fn from_annotation(annotation: Option<&Expr>) -> Self {
+        annotation.map_or(Self::Unknown, |annotation| {
+            if annotation.range().len().to_u32() > 512 {
+                return Self::Unknown;
+            }
+            Self::parse(annotation, 0, &mut 64)
+        })
+    }
+
+    fn from_name(name: &str) -> Self {
+        match name.trim() {
+            "int" => Self::Int,
+            "float" => Self::Float,
+            "bool" => Self::Bool,
+            "None" => Self::None,
+            "str" => Self::Str,
+            _ => Self::Unknown,
+        }
+    }
+
+    fn parse(annotation: &Expr, depth: usize, remaining: &mut usize) -> Self {
+        if depth >= 16 || *remaining == 0 {
+            return Self::Unknown;
+        }
+        *remaining -= 1;
+        match annotation {
+            Expr::Name(name) => Self::from_name(name.id.as_str()),
+            Expr::StringLiteral(value) => Self::from_name(&value.value.to_string()),
+            Expr::NoneLiteral(_) => Self::None,
+            Expr::Subscript(subscript) => {
+                let name = match subscript.value.as_ref() {
+                    Expr::Name(name) => name.id.as_str(),
+                    Expr::Attribute(attribute) => attribute.attr.id(),
+                    _ => return Self::Unknown,
+                };
+                match (name, subscript.slice.as_ref()) {
+                    ("list" | "List", element) => Self::List(Box::new(Self::parse(element, depth + 1, remaining))),
+                    ("tuple" | "Tuple", Expr::Tuple(tuple))
+                        if tuple.elts.len() == 2 && matches!(tuple.elts[1], Expr::EllipsisLiteral(_)) =>
+                    {
+                        Self::Tuple(Box::new(Self::parse(&tuple.elts[0], depth + 1, remaining)))
+                    }
+                    ("dict" | "Dict", Expr::Tuple(tuple)) if tuple.elts.len() == 2 => Self::Dict {
+                        key: Box::new(Self::parse(&tuple.elts[0], depth + 1, remaining)),
+                        value: Box::new(Self::parse(&tuple.elts[1], depth + 1, remaining)),
+                    },
+                    ("Optional", element) => Self::Union(vec![Self::parse(element, depth + 1, remaining), Self::None]),
+                    _ => Self::Unknown,
+                }
+            }
+            Expr::BinOp(binary) if binary.op == ast::Operator::BitOr => Self::Union(vec![
+                Self::parse(&binary.left, depth + 1, remaining),
+                Self::parse(&binary.right, depth + 1, remaining),
+            ]),
+            _ => Self::Unknown,
+        }
+    }
+}
+
+/// Local layout and source hints persisted so restored code can rebuild its optimized form.
+#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
+pub(crate) struct FunctionHints {
+    #[serde(rename = "P")]
+    pub parameters: Vec<TypeHint>,
+    #[serde(rename = "R")]
+    pub returns: TypeHint,
+    #[serde(rename = "L")]
+    pub locals: u16,
+    #[serde(rename = "B", default)]
+    pub builtin_names: Vec<(StringId, BuiltinHint)>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub(crate) enum BuiltinHint {
+    #[serde(rename = "R")]
+    Range,
+    #[serde(rename = "L")]
+    Len,
+}
+
+impl BuiltinHint {
+    pub(crate) fn from_name(name: &str) -> Option<Self> {
+        match name {
+            "range" => Some(Self::Range),
+            "len" => Some(Self::Len),
+            _ => None,
+        }
+    }
+}
+
+impl FunctionHints {
+    pub(crate) fn is_useful(&self) -> bool {
+        self.returns != TypeHint::Unknown || self.parameters.iter().any(|hint| *hint != TypeHint::Unknown)
+    }
+}
diff --git a/crates/monty/src/bytecode/aot/ir.rs b/crates/monty/src/bytecode/aot/ir.rs
new file mode 100644
index 00000000..4fe24a59
--- /dev/null
+++ b/crates/monty/src/bytecode/aot/ir.rs
@@ -0,0 +1,1105 @@
+//! Typed values and explicit control flow for effect-free function kernels.
+
+use std::{
+    collections::{BTreeSet, VecDeque},
+    iter::repeat_n,
+};
+
+use super::{BuiltinHint, FunctionHints, TypeHint};
+use crate::{
+    builtins::BuiltinsFunctions,
+    bytecode::{Code, Opcode},
+    intern::StringId,
+    value::Value,
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Kind {
+    Unbound,
+    Unknown,
+    Int,
+    Float,
+    Bool,
+    None,
+    Range,
+    Iterator,
+    SequenceIterator(Element),
+    Maybe(Element),
+    TupleValue(Element, u16),
+    Callable(BuiltinHint),
+    List(Element),
+    Tuple(Element),
+    Sequence(Element),
+    Dict(Element),
+    Str,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[repr(u8)]
+pub(crate) enum Element {
+    Int = 1,
+    Float = 2,
+    Bool = 3,
+    None = 4,
+}
+impl Element {
+    fn hint(hint: &TypeHint) -> Option<Self> {
+        match hint {
+            TypeHint::Int => Some(Self::Int),
+            TypeHint::Float => Some(Self::Float),
+            TypeHint::Bool => Some(Self::Bool),
+            TypeHint::None => Some(Self::None),
+            _ => None,
+        }
+    }
+    pub(crate) fn kind(self) -> Kind {
+        match self {
+            Self::Int => Kind::Int,
+            Self::Float => Kind::Float,
+            Self::Bool => Kind::Bool,
+            Self::None => Kind::None,
+        }
+    }
+}
+
+impl Kind {
+    fn hint(hint: &TypeHint) -> Self {
+        match hint {
+            TypeHint::Int => Self::Int,
+            TypeHint::Float => Self::Float,
+            TypeHint::Bool => Self::Bool,
+            TypeHint::None => Self::None,
+            TypeHint::Str => Self::Str,
+            TypeHint::List(element) => Element::hint(element).map_or(Self::Unknown, Self::List),
+            TypeHint::Tuple(element) => Element::hint(element).map_or(Self::Unknown, Self::Tuple),
+            TypeHint::Dict { key, value } if **key == TypeHint::Str => {
+                Element::hint(value).map_or(Self::Unknown, Self::Dict)
+            }
+            TypeHint::Union(choices) => {
+                let mut element = None;
+                for choice in choices {
+                    let kind = Self::hint(choice);
+                    let Some(current) = kind.sequence_element() else {
+                        return Self::Unknown;
+                    };
+                    if element.is_some_and(|old| old != current) {
+                        return Self::Unknown;
+                    }
+                    element = Some(current);
+                }
+                element.map_or(Self::Unknown, Self::Sequence)
+            }
+            _ => Self::Unknown,
+        }
+    }
+
+    pub(crate) fn scalar(self) -> bool {
+        matches!(self, Self::Int | Self::Float | Self::Bool | Self::None)
+    }
+    fn ordinary(self) -> bool {
+        self.scalar() || self.reference() || matches!(self, Self::Range | Self::Maybe(_))
+    }
+    pub(crate) fn reference(self) -> bool {
+        matches!(
+            self,
+            Self::List(_) | Self::Tuple(_) | Self::Sequence(_) | Self::Dict(_) | Self::Str
+        )
+    }
+    pub(crate) fn sequence_element(self) -> Option<Element> {
+        match self {
+            Self::List(element) | Self::Tuple(element) | Self::Sequence(element) => Some(element),
+            _ => None,
+        }
+    }
+
+    fn join(self, other: Self) -> Self {
+        if self == other {
+            return self;
+        }
+        let maybe = |kind| match kind {
+            Self::Int => Some(Element::Int),
+            Self::Float => Some(Element::Float),
+            Self::Bool => Some(Element::Bool),
+            Self::None => Some(Element::None),
+            Self::Maybe(element) => Some(element),
+            _ => None,
+        };
+        match (self, other) {
+            (Self::Unbound, kind) | (kind, Self::Unbound) => maybe(kind).map_or(Self::Unknown, Self::Maybe),
+            (Self::Maybe(element), kind) | (kind, Self::Maybe(element)) if maybe(kind) == Some(element) => {
+                Self::Maybe(element)
+            }
+            _ => Self::Unknown,
+        }
+    }
+
+    pub(crate) fn numeric(self) -> bool {
+        matches!(self, Self::Int | Self::Float | Self::Bool)
+    }
+}
+
+#[derive(Debug, Clone)]
+pub(crate) enum Operation {
+    Copy {
+        dst: usize,
+        src: usize,
+        kind: Kind,
+    },
+    Binary {
+        dst: usize,
+        left: usize,
+        right: usize,
+        op: Opcode,
+        lhs: Kind,
+        rhs: Kind,
+    },
+    Unary {
+        dst: usize,
+        src: usize,
+        op: Opcode,
+        kind: Kind,
+    },
+    Range {
+        dst: usize,
+        arguments: Vec<usize>,
+    },
+    Iter {
+        dst: usize,
+        src: usize,
+        kind: Kind,
+    },
+    Length {
+        dst: usize,
+        object: usize,
+        kind: Kind,
+    },
+    Index {
+        dst: usize,
+        object: usize,
+        key: usize,
+        kind: Kind,
+    },
+    Unpack {
+        dst: usize,
+        object: usize,
+        count: usize,
+        element: Element,
+    },
+    GuardBound {
+        src: usize,
+    },
+    Bound {
+        dst: usize,
+        bound: bool,
+    },
+    Checkpoint,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct Instruction {
+    pub ip: usize,
+    pub weight: usize,
+    pub operation: Operation,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) enum Terminator {
+    Jump(usize),
+    ForIter {
+        iterator: usize,
+        item: usize,
+        element: Option<Element>,
+        yes: usize,
+        no: usize,
+    },
+    Branch {
+        condition: usize,
+        kind: Kind,
+        yes: usize,
+        no: usize,
+    },
+    Return {
+        source: usize,
+        kind: Kind,
+    },
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct Block {
+    pub instructions: Vec<Instruction>,
+    pub terminal_ip: usize,
+    pub terminal_weight: usize,
+    pub terminator: Terminator,
+}
+
+#[derive(Debug)]
+pub(crate) struct Plan {
+    pub scalar_call_cost: Option<usize>,
+    pub needs_views: bool,
+    pub parameters: Vec<Kind>,
+    pub builtin_globals: Vec<(usize, BuiltinHint)>,
+    pub locals: usize,
+    pub registers: usize,
+    pub initial_values: Vec<(usize, u64)>,
+    pub blocks: Vec<Block>,
+}
+
+#[derive(Debug, Clone)]
+struct Decoded {
+    ip: usize,
+    next: usize,
+    op: Opcode,
+    argument: usize,
+    target: Option<usize>,
+    builtin: Option<BuiltinHint>,
+}
+
+impl Decoded {
+    fn terminal(&self) -> bool {
+        matches!(
+            self.op,
+            Opcode::Jump
+                | Opcode::JumpIfFalse
+                | Opcode::JumpIfTrue
+                | Opcode::JumpIfFalseOrPop
+                | Opcode::JumpIfTrueOrPop
+                | Opcode::ForIter
+                | Opcode::ReturnValue
+        )
+    }
+}
+
+#[derive(Clone, PartialEq, Eq)]
+struct State {
+    locals: Vec<Kind>,
+    stack: Vec<Kind>,
+}
+
+fn binary_result(op: Opcode, left: Kind, right: Kind) -> Option<Kind> {
+    use Opcode as O;
+    if matches!(op, O::CompareEq | O::CompareNe) && left.scalar() && right.scalar() {
+        return Some(Kind::Bool);
+    }
+    if matches!(op, O::CompareIs | O::CompareIsNot)
+        && left.scalar()
+        && right.scalar()
+        && (left == Kind::None || right == Kind::None || (left == Kind::Bool && right == Kind::Bool))
+    {
+        return Some(Kind::Bool);
+    }
+    if !left.numeric() || !right.numeric() {
+        return None;
+    }
+    match op {
+        O::CompareEq | O::CompareNe | O::CompareLt | O::CompareLe | O::CompareGt | O::CompareGe => Some(Kind::Bool),
+        O::BinaryAdd | O::InplaceAdd | O::BinarySub | O::InplaceSub | O::BinaryMul | O::InplaceMul => {
+            Some(if left == Kind::Float || right == Kind::Float {
+                Kind::Float
+            } else {
+                Kind::Int
+            })
+        }
+        O::BinaryDiv | O::InplaceDiv => Some(Kind::Float),
+        O::BinaryFloorDiv | O::InplaceFloorDiv | O::BinaryMod | O::InplaceMod
+            if left != Kind::Float && right != Kind::Float =>
+        {
+            Some(Kind::Int)
+        }
+        O::BinaryAnd | O::InplaceAnd | O::BinaryOr | O::InplaceOr | O::BinaryXor | O::InplaceXor
+            if left != Kind::Float && right != Kind::Float =>
+        {
+            Some(if left == Kind::Bool && right == Kind::Bool {
+                Kind::Bool
+            } else {
+                Kind::Int
+            })
+        }
+        _ => None,
+    }
+}
+
+fn unary_result(op: Opcode, kind: Kind) -> Option<Kind> {
+    match op {
+        Opcode::UnaryNot if kind.scalar() => Some(Kind::Bool),
+        Opcode::UnaryNeg | Opcode::UnaryPos if kind.numeric() => {
+            Some(if kind == Kind::Bool { Kind::Int } else { kind })
+        }
+        Opcode::UnaryInvert if matches!(kind, Kind::Bool | Kind::Int) => Some(Kind::Int),
+        _ => None,
+    }
+}
+
+fn constant(code: &Code, instruction: &Decoded) -> Option<(Kind, u64)> {
+    match instruction.op {
+        Opcode::LoadSmallInt => Some((
+            Kind::Int,
+            i64::from(u8::try_from(instruction.argument).ok()?.cast_signed()).cast_unsigned(),
+        )),
+        Opcode::LoadTrue => Some((Kind::Bool, 1)),
+        Opcode::LoadFalse => Some((Kind::Bool, 0)),
+        Opcode::LoadNone => Some((Kind::None, 0)),
+        Opcode::LoadConst => match code.constants().get(instruction.argument)? {
+            Value::Int(value) => Some((Kind::Int, value.cast_unsigned())),
+            Value::Float(value) => Some((Kind::Float, value.to_bits())),
+            Value::Bool(value) => Some((Kind::Bool, u64::from(*value))),
+            Value::None => Some((Kind::None, 0)),
+            Value::InternString(_) => Some((
+                Kind::Str,
+                (code.aot_hints()?.parameters.len() + instruction.argument) as u64,
+            )),
+            _ => None,
+        },
+        _ => None,
+    }
+}
+
+fn is_load_local(op: Opcode) -> bool {
+    matches!(
+        op,
+        Opcode::LoadLocal0
+            | Opcode::LoadLocal1
+            | Opcode::LoadLocal2
+            | Opcode::LoadLocal3
+            | Opcode::LoadLocal
+            | Opcode::LoadLocalW
+    )
+}
+
+fn transfer(code: &Code, instruction: &Decoded, state: &mut State) -> Option<()> {
+    let op = instruction.op;
+    if let Some((kind, _)) = constant(code, instruction) {
+        state.stack.push(kind);
+    } else if is_load_local(op) {
+        let kind = *state.locals.get(instruction.argument)?;
+        // An unbound load is observable even when its result is subsequently discarded.
+        if !kind.ordinary() {
+            return None;
+        }
+        state.stack.push(if let Kind::Maybe(element) = kind {
+            element.kind()
+        } else {
+            kind
+        });
+    } else {
+        match op {
+            Opcode::StoreLocal | Opcode::StoreLocalW => {
+                let kind = state.stack.pop()?;
+                if !kind.ordinary() {
+                    return None;
+                }
+                *state.locals.get_mut(instruction.argument)? = kind;
+            }
+            Opcode::LoadGlobalCallable => state.stack.push(Kind::Callable(instruction.builtin?)),
+            Opcode::CallBuiltinType | Opcode::CallBuiltinFunction | Opcode::CallFunction => {
+                let start = state.stack.len().checked_sub(instruction.argument)?;
+                let arguments = state.stack.drain(start..).collect::<Vec<_>>();
+                let builtin = if op == Opcode::CallFunction {
+                    let Kind::Callable(builtin) = state.stack.pop()? else {
+                        return None;
+                    };
+                    builtin
+                } else {
+                    instruction.builtin?
+                };
+                let result = match builtin {
+                    BuiltinHint::Range => {
+                        if !(1..=3).contains(&arguments.len())
+                            || arguments.iter().any(|kind| !matches!(kind, Kind::Int | Kind::Bool))
+                        {
+                            return None;
+                        }
+                        Kind::Range
+                    }
+                    BuiltinHint::Len => {
+                        if arguments.len() != 1
+                            || !(arguments[0].sequence_element().is_some() || matches!(arguments[0], Kind::Dict(_)))
+                        {
+                            return None;
+                        }
+                        Kind::Int
+                    }
+                };
+                state.stack.push(result);
+            }
+            Opcode::BinarySubscr => {
+                let key = state.stack.pop()?;
+                let object = state.stack.pop()?;
+                let element = if let Some(element) = object.sequence_element() {
+                    if !matches!(key, Kind::Int | Kind::Bool) {
+                        return None;
+                    }
+                    element
+                } else if let Kind::Dict(element) = object {
+                    if key != Kind::Str {
+                        return None;
+                    }
+                    element
+                } else {
+                    return None;
+                };
+                state.stack.push(element.kind());
+            }
+            Opcode::BuildTuple => {
+                let start = state.stack.len().checked_sub(instruction.argument)?;
+                let items = state.stack.drain(start..).collect::<Vec<_>>();
+                let element = match items.first().copied().unwrap_or(Kind::None) {
+                    Kind::Int => Element::Int,
+                    Kind::Float => Element::Float,
+                    Kind::Bool => Element::Bool,
+                    Kind::None => Element::None,
+                    _ => return None,
+                };
+                if items.iter().any(|kind| *kind != element.kind()) {
+                    return None;
+                }
+                state
+                    .stack
+                    .push(Kind::TupleValue(element, u16::try_from(items.len()).ok()?));
+            }
+            Opcode::UnpackSequence => {
+                let value = state.stack.pop()?;
+                let element = match value {
+                    Kind::TupleValue(element, count) if usize::from(count) == instruction.argument => element,
+                    _ => value.sequence_element()?,
+                };
+                if instruction.argument > 256 {
+                    return None;
+                }
+                state.stack.extend(repeat_n(element.kind(), instruction.argument));
+            }
+            Opcode::GetIter => {
+                let kind = state.stack.pop()?;
+                let iterator = if kind == Kind::Range {
+                    Kind::Iterator
+                } else {
+                    Kind::SequenceIterator(kind.sequence_element()?)
+                };
+                state.stack.push(iterator);
+            }
+            Opcode::ForIter => {
+                if !matches!(state.stack.last()?, Kind::Iterator | Kind::SequenceIterator(_)) {
+                    return None;
+                }
+            }
+            Opcode::Pop => {
+                state.stack.pop()?;
+            }
+            Opcode::Dup => {
+                let kind = *state.stack.last()?;
+                if !kind.ordinary() {
+                    return None;
+                }
+                state.stack.push(kind);
+            }
+            Opcode::Rot2 => {
+                let n = state.stack.len().checked_sub(2)?;
+                state.stack.swap(n, n + 1);
+            }
+            Opcode::Nop | Opcode::Jump => {}
+            Opcode::JumpIfTrue | Opcode::JumpIfFalse | Opcode::JumpIfTrueOrPop | Opcode::JumpIfFalseOrPop => {
+                if !state.stack.last()?.scalar() {
+                    return None;
+                }
+            }
+            Opcode::ReturnValue => {
+                if !state.stack.last()?.scalar() && !matches!(state.stack.last()?, Kind::TupleValue(_, _)) {
+                    return None;
+                }
+            }
+            Opcode::UnaryNeg | Opcode::UnaryPos | Opcode::UnaryNot | Opcode::UnaryInvert => {
+                let kind = state.stack.pop()?;
+                state.stack.push(unary_result(op, kind)?);
+            }
+            _ => {
+                let right = state.stack.pop()?;
+                let left = state.stack.pop()?;
+                state.stack.push(binary_result(op, left, right)?);
+            }
+        }
+    }
+    (state.stack.len() <= 256).then_some(())
+}
+
+impl Plan {
+    pub(crate) fn compile(code: &Code, hints: &FunctionHints) -> Option<Self> {
+        if cfg!(feature = "experimental-fusion")
+            || code.has_exception_handlers()
+            || code.bytecode().len() > 16_384
+            || hints.locals > 256
+            || hints.parameters.len() > usize::from(hints.locals)
+        {
+            return None;
+        }
+        let bytes = code.bytecode();
+        let mut decoded = Vec::new();
+        let mut starts = BTreeSet::from([0]);
+        let mut builtin_globals = Vec::new();
+        let mut ip = 0;
+        while ip < bytes.len() {
+            let op = Opcode::from_repr(bytes[ip])?;
+            let next = ip + op.encoded_len(bytes, ip)?;
+            let u16_arg = || usize::from(u16::from_le_bytes([bytes[ip + 1], bytes[ip + 2]]));
+            if op == Opcode::BuildTuple
+                && !matches!(
+                    bytes.get(next).and_then(|byte| Opcode::from_repr(*byte)),
+                    Some(Opcode::ReturnValue | Opcode::UnpackSequence)
+                )
+            {
+                return None;
+            }
+            let mut builtin = None;
+            let argument = match op {
+                Opcode::LoadLocal0 => 0,
+                Opcode::LoadLocal1 => 1,
+                Opcode::LoadLocal2 => 2,
+                Opcode::LoadLocal3 => 3,
+                Opcode::LoadLocal | Opcode::StoreLocal | Opcode::LoadSmallInt => usize::from(bytes[ip + 1]),
+                Opcode::LoadLocalW | Opcode::StoreLocalW | Opcode::LoadConst | Opcode::BuildTuple => u16_arg(),
+                Opcode::UnpackSequence => usize::from(bytes[ip + 1]),
+                Opcode::LoadGlobalCallable => {
+                    let id = StringId::from_index(u16::from_le_bytes([bytes[ip + 3], bytes[ip + 4]]));
+                    let hint = hints.builtin_names.iter().find(|(name, _)| *name == id)?.1;
+                    builtin = Some(hint);
+                    builtin_globals.push((u16_arg(), hint));
+                    u16_arg()
+                }
+                Opcode::CallFunction => usize::from(bytes[ip + 1]),
+                Opcode::CallBuiltinType => {
+                    if bytes[ip + 1] != 10 {
+                        return None;
+                    }
+                    builtin = Some(BuiltinHint::Range);
+                    usize::from(bytes[ip + 2])
+                }
+                Opcode::CallBuiltinFunction => {
+                    if BuiltinsFunctions::from_repr(bytes[ip + 1])? != BuiltinsFunctions::Len {
+                        return None;
+                    }
+                    builtin = Some(BuiltinHint::Len);
+                    usize::from(bytes[ip + 2])
+                }
+                _ => 0,
+            };
+            let target = if matches!(
+                op,
+                Opcode::Jump
+                    | Opcode::JumpIfTrue
+                    | Opcode::JumpIfFalse
+                    | Opcode::JumpIfTrueOrPop
+                    | Opcode::JumpIfFalseOrPop
+                    | Opcode::ForIter
+            ) {
+                let offset = i16::from_le_bytes([bytes[ip + 1], bytes[ip + 2]]);
+                let target = next.checked_add_signed(isize::from(offset))?;
+                starts.insert(target);
+                Some(target)
+            } else {
+                None
+            };
+            let instruction = Decoded {
+                ip,
+                next,
+                op,
+                argument,
+                target,
+                builtin,
+            };
+            if instruction.terminal() && next < bytes.len() {
+                starts.insert(next);
+            }
+            decoded.push(instruction);
+            ip = next;
+        }
+        if decoded.is_empty() || starts.len() > 256 {
+            return None;
+        }
+        let starts = starts.into_iter().collect::<Vec<_>>();
+        let mut ranges = Vec::new();
+        for (index, &start) in starts.iter().enumerate() {
+            let first = decoded.binary_search_by_key(&start, |i| i.ip).ok()?;
+            let end = match starts.get(index + 1) {
+                Some(next) => decoded.binary_search_by_key(next, |i| i.ip).ok()?,
+                None => decoded.len(),
+            };
+            ranges.push(first..end);
+        }
+        let parameters = hints.parameters.iter().map(Kind::hint).collect::<Vec<_>>();
+        let locals = usize::from(hints.locals);
+        let mut entry = State {
+            locals: vec![Kind::Unbound; locals],
+            stack: Vec::new(),
+        };
+        entry.locals[..parameters.len()].copy_from_slice(&parameters);
+        let mut states = vec![None; ranges.len()];
+        states[0] = Some(entry);
+        let mut queue = VecDeque::from([0]);
+        let mut visits = 0;
+        let mut failed = vec![false; ranges.len()];
+        let mut max_stack = 0;
+        while let Some(index) = queue.pop_front() {
+            visits += 1;
+            if visits > 65_536 {
+                return None;
+            }
+            let mut state = states[index].clone()?;
+            max_stack = max_stack.max(state.stack.len());
+            let instructions = &decoded[ranges[index].clone()];
+            failed[index] = false;
+            for instruction in instructions {
+                if transfer(code, instruction, &mut state).is_none() {
+                    failed[index] = true;
+                    break;
+                }
+                max_stack = max_stack.max(state.stack.len());
+            }
+            if failed[index] {
+                continue;
+            }
+            let last = instructions.last()?;
+            let mut successors = Vec::new();
+            match last.op {
+                Opcode::ReturnValue => {}
+                Opcode::ForIter => {
+                    let mut exhausted = state.clone();
+                    exhausted.stack.pop()?;
+                    successors.push((last.target?, exhausted));
+                    let element = match state.stack.last()? {
+                        Kind::Iterator => Kind::Int,
+                        Kind::SequenceIterator(element) => element.kind(),
+                        _ => return None,
+                    };
+                    state.stack.push(element);
+                    successors.push((last.next, state));
+                }
+                Opcode::Jump => successors.push((last.target?, state)),
+                Opcode::JumpIfTrue | Opcode::JumpIfFalse => {
+                    state.stack.pop()?;
+                    successors.push((last.target?, state.clone()));
+                    successors.push((last.next, state));
+                }
+                Opcode::JumpIfTrueOrPop | Opcode::JumpIfFalseOrPop => {
+                    successors.push((last.target?, state.clone()));
+                    state.stack.pop()?;
+                    successors.push((last.next, state));
+                }
+                _ => successors.push((last.next, state)),
+            }
+            for (target, incoming) in successors {
+                let target = starts.binary_search(&target).ok()?;
+                let changed = match &mut states[target] {
+                    None => {
+                        states[target] = Some(incoming);
+                        true
+                    }
+                    Some(old) => {
+                        if old.stack.len() != incoming.stack.len() {
+                            return None;
+                        }
+                        let mut changed = false;
+                        for (old, new) in old
+                            .locals
+                            .iter_mut()
+                            .chain(&mut old.stack)
+                            .zip(incoming.locals.iter().chain(&incoming.stack))
+                        {
+                            let joined = old.join(*new);
+                            if joined != *old {
+                                *old = joined;
+                                changed = true;
+                            }
+                        }
+                        changed
+                    }
+                };
+                if changed {
+                    queue.push_back(target);
+                }
+            }
+        }
+        if failed.iter().any(|&failed| failed) {
+            return None;
+        }
+        let mut plan = Self {
+            scalar_call_cost: None,
+            needs_views: false,
+            parameters,
+            builtin_globals,
+            locals,
+            registers: 3 * (locals + max_stack),
+            initial_values: Vec::new(),
+            blocks: Vec::new(),
+        };
+        let mut block_map = vec![None; ranges.len()];
+        for (index, state) in states.iter().enumerate() {
+            if state.is_some() {
+                block_map[index] = Some(plan.blocks.len());
+                plan.blocks.push(Block {
+                    instructions: Vec::new(),
+                    terminal_ip: 0,
+                    terminal_weight: 0,
+                    terminator: Terminator::Jump(0),
+                });
+            }
+        }
+        for (index, range) in ranges.into_iter().enumerate() {
+            let Some(mut state) = states[index].clone() else {
+                continue;
+            };
+            let mut local_values = (0..locals).map(|i| 3 * i).collect::<Vec<_>>();
+            let mut stack = (locals..locals + state.stack.len()).map(|i| 3 * i).collect::<Vec<_>>();
+            let mut output = Vec::new();
+            let mut pending = 0;
+            let instructions = &decoded[range];
+            let last = instructions.last()?;
+            for instruction in instructions {
+                let op = instruction.op;
+                if instruction.terminal() {
+                    break;
+                }
+                pending += 1;
+                if let Some((_, bits)) = constant(code, instruction) {
+                    let dst = plan.fresh()?;
+                    plan.initial_values.push((dst, bits));
+                    stack.push(dst);
+                } else if is_load_local(op) {
+                    let src = *local_values.get(instruction.argument)?;
+                    if matches!(state.locals[instruction.argument], Kind::Maybe(_)) {
+                        output.push(Instruction {
+                            ip: instruction.ip,
+                            weight: pending,
+                            operation: Operation::GuardBound { src: src + 1 },
+                        });
+                        pending = 0;
+                    }
+                    stack.push(src);
+                } else {
+                    let operation = match op {
+                        Opcode::StoreLocal | Opcode::StoreLocalW => {
+                            local_values[instruction.argument] = stack.pop()?;
+                            None
+                        }
+                        Opcode::LoadGlobalCallable => {
+                            let dst = plan.fresh()?;
+                            plan.initial_values.push((dst, 0));
+                            stack.push(dst);
+                            None
+                        }
+                        Opcode::CallBuiltinType | Opcode::CallBuiltinFunction | Opcode::CallFunction => {
+                            let start = stack.len().checked_sub(instruction.argument)?;
+                            let arguments = stack.drain(start..).collect();
+                            if op == Opcode::CallFunction {
+                                stack.pop()?;
+                            }
+                            let builtin = if op == Opcode::CallFunction {
+                                let Kind::Callable(builtin) = state.stack[state.stack.len() - instruction.argument - 1]
+                                else {
+                                    return None;
+                                };
+                                builtin
+                            } else {
+                                instruction.builtin?
+                            };
+                            match builtin {
+                                BuiltinHint::Range => {
+                                    let dst = plan.fresh_range()?;
+                                    stack.push(dst);
+                                    Some(Operation::Range { dst, arguments })
+                                }
+                                BuiltinHint::Len => {
+                                    let dst = plan.fresh()?;
+                                    stack.push(dst);
+                                    Some(Operation::Length {
+                                        dst,
+                                        object: arguments[0],
+                                        kind: *state.stack.last()?,
+                                    })
+                                }
+                            }
+                        }
+                        Opcode::BinarySubscr => {
+                            let key = stack.pop()?;
+                            let object = stack.pop()?;
+                            let dst = plan.fresh()?;
+                            stack.push(dst);
+                            plan.needs_views |= state.stack[state.stack.len() - 2].sequence_element().is_some();
