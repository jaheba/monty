+                            stack.swap(n, n + 1);
+                            None
+                        }
+                        Opcode::Nop => None,
+                        Opcode::UnaryNeg | Opcode::UnaryPos | Opcode::UnaryNot | Opcode::UnaryInvert => {
+                            let src = stack.pop()?;
+                            let dst = plan.fresh()?;
+                            stack.push(dst);
+                            Some(Operation::Unary {
+                                dst,
+                                src,
+                                op,
+                                kind: *state.stack.last()?,
+                            })
+                        }
+                        _ => {
+                            let right = stack.pop()?;
+                            let left = stack.pop()?;
+                            let dst = plan.fresh()?;
+                            stack.push(dst);
+                            let n = state.stack.len();
